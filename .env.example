# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Deepgram
DEEPGRAM_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deepgram TTS — voz en español mexicano, configurable
DEEPGRAM_TTS_VOICE=aura-2-diana-es

# URL pública del servidor (Railway) para webhooks/streams de Twilio
PUBLIC_BASE_URL=

# Puerto del servidor
PORT=3000

# Umbral de silencio para endpointing (ms)
ENDPOINTING_MS=500

# Habilitar muletillas de relleno mientras el LLM genera
ENABLE_FILLER_PHRASES=true

# Modelo de OpenAI para conversación
OPENAI_MODEL=gpt-4.1

# Modelo de OpenAI para generación de reportes
OPENAI_REPORT_MODEL=gpt-4.1-mini

# Google Calendar OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Cifrado de tokens (32 bytes en base64, generar con: openssl rand -base64 32)
ENCRYPTION_KEY=

# Twilio WhatsApp (opcional — si no se configura, la confirmación va por SMS)
TWILIO_WHATSAPP_FROM=

# Answering Machine Detection (default true — desactiva sin redeploy)
AMD_ENABLED=true

# Silence monitor (ms)
SILENCE_NUDGE_AFTER_QUESTION_MS=6000
SILENCE_NUDGE_AFTER_STATEMENT_MS=9000
SILENCE_GOODBYE_AFTER_MS=8000

# Filler phrases
FILLER_DELAY_MS=350
FILLER_MAX_PER_CALL=2
